# HTTP-порт приложения
APP_PORT=8080

# Подключение к Postgres
POSTGRES_DSN=host=localhost user=avigo password=avigo dbname=avigo port=5432 sslmode=disable

# Подключение к Redis (кэш списков + refresh-токены)
REDIS_ADDR=localhost:6379

# Kafka broker (с хоста — localhost:29092, внутри docker-сети — kafka:9092)
KAFKA_BROKERS=localhost:29092

# Секрет подписи JWT. ОБЯЗАТЕЛЕН: без него приложение не стартует.
JWT_SECRET=

# Срок действия буста объявления (Go duration)
BOOST_DURATION=24h
